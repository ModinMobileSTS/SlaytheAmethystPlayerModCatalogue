{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ModinMobileSTS/SlaytheAmethystPlayerModCatalogue/main/schemas/metadata.schema.json",
  "title": "Slay the Amethyst AI patch metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "description", "version", "author", "target", "jar"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 4000},
    "version": {"type": "string", "minLength": 1, "maxLength": 120},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "email": {"type": "string", "maxLength": 254, "pattern": "^[^\\s<>@]+@[^\\s<>@]+\\.[^\\s<>@]+$"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modId", "workshopId", "versions"],
      "properties": {
        "modId": {"type": "string", "minLength": 1, "maxLength": 120},
        "workshopId": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    },
    "jar": {"type": "string", "minLength": 5, "maxLength": 120, "pattern": "^[^/\\\\<>:\"|?*\\u0000-\\u001f]+\\.[jJ][aA][rR]$"},
    "example": {"type": "boolean", "default": false}
  },
  "$comment": "The generator also validates NFC, safe path segments, exact directory naming, wildcard semantics, Workshop ID mapping and the JAR/ModTheSpire.json. See docs/catalogue.md."
}
